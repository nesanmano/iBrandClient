<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false">

  <targets>
    <target name="main" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="main.log"
      archiveFileName="archives/main.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
      enableArchiveFileCompression="true" />
	
    <target name="rest" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=false}] => ${message} ${exception:format=ToString}"
      fileName="rest.log"
      archiveFileName="archives/rest.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
      enableArchiveFileCompression="true" />
	
    <target name="synchro" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="synchro.log"
      archiveFileName="archives/synchro.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
      enableArchiveFileCompression="true" />
	
    <target name="cli" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="cli.log"
      archiveFileName="archives/cli.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
	  enableArchiveFileCompression="true" />
	  
	<target name="sweepstakes" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} => ${message} ${exception:format=ToString}"
      fileName="sweepstakes.log"
      archiveFileName="archives/sweepstakes.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="1"
	  enableArchiveFileCompression="true" />
	  
	  <target name="file_ui" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} => ${message} ${exception:format=ToString}"
      fileName="file_ui.log"
      archiveFileName="archives/file_ui.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="1"
	  enableArchiveFileCompression="true" />
	  
	  <target name="services" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} => ${message} ${exception:format=ToString}"
      fileName="services.log"
      archiveFileName="archives/services.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="1"
	  enableArchiveFileCompression="true" />
	  
	  <target name="lang" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} => ${message} ${exception:format=ToString}"
      fileName="lang.log"
      archiveFileName="archives/lang.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="1"
	  enableArchiveFileCompression="true" />
  </targets>

  <rules>
    
	<!-- Traçage pour l'affichage de la gallery de fichiers.
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.Gallery.GallerySourceFixedDirectory" minlevel="Debug" writeTo="file_ui" />
	<logger name="NomadLogic.Common.Util.DateAndTime.DateTimeCalculatorFromNow" minlevel="Debug" writeTo="file_ui" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.ScreenDefinitionGalleryFromFiles" minlevel="Trace" writeTo="file_ui" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.Gallery.GallerySourceFromServerRespondantData" minlevel="Trace" writeTo="rest" />
	-->
  
  <!-- Tests sur les texte d'affichages des questions Combo, et des réponses mises en mémoire.
	<logger name="NomadLogic.iBrandDesktop.Ui.Choice.Choice" minlevel="Trace" writeTo="lang" />
	<logger name="NomadLogic.iBrandDesktop.Ui.Question.QuestionComboItem" minlevel="Trace" writeTo="lang" />
	<logger name="NomadLogic.iBrandDesktop.Ui.Question.QuestionCombo" minlevel="Trace" writeTo="lang" />
	-->
  
  <!-- Test pour Eshots
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.BarcodeScreen" minlevel="Debug" writeTo="main" />
	<logger name="NomadLogic.Common.Services.SynchronizationService" minlevel="Trace" writeTo="synchro" />
	<logger name="NomadLogic.iBrandDesktop.Synchro.UploadProjectData" minlevel="Trace" writeTo="synchro" />
	<logger name="NomadLogic.iBrandDesktop.Util.SubmitAction.Generic.Worker.SendMultimediaToEshotsWorkerBase" minlevel="Trace" writeTo="rest" />
	<logger name="NomadLogic.Common.Util.QuestionnaireWebRequest.Eshots.WebRequestEshots" minlevel="Trace" writeTo="rest" />
	<logger name="NomadLogic.Common.Util.HttpRestUtil" minlevel="Trace" writeTo="rest" />
    -->
  
  <!-- Autres
    <logger name="NomadLogic.Common.Services.FileDownloadService" minlevel="Trace" writeTo="main" />
	<logger name="NomadLogic.Common.Services.ServiceLongRunningAbstract" minlevel="Debug" writeTo="main" />
  	
  
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.ScreenDefinitionGalleryIndexSelection" minlevel="Debug" writeTo="ui" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.PaginationUiElements*" minlevel="Debug" writeTo="ui" />
			
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.RecordVideoWithPresentation" minlevel="Trace" writeTo="ui" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.RecordVideoScreen" minlevel="Trace" writeTo="ui" />
	
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.ScreenDefinitionGalleryIndexSelection" minlevel="Trace" writeTo="main" />
	<logger name="NomadLogic.iBrandDesktop.Util.SubmitAction.Generic.Worker.SendMultimediaToEshotsWorker" minlevel="Trace" writeTo="rest" />
	
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.RecordVideoScreen" minlevel="Debug" writeTo="main" />
	<logger name="NomadLogic.Common.Multimedia.ImageMagickCLI.*" minlevel="Trace" writeTo="cli" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.custom._360.*" minlevel="Trace" writeTo="sweepstakes" />
	<logger name="NomadLogic.Common.Services.Database.*" minlevel="Trace" writeTo="main" />
	
	<logger name="NomadLogic.Common.Util.QuestionnaireWebRequest.WebRequestFacade" minlevel="Trace" writeTo="rest" />
	<logger name="NomadLogic.Common.Util.QuestionnaireWebRequest.Emisys.*" minlevel="Debug" writeTo="rest" />
	
	
	<logger name="NomadLogic.iBrandDesktop.Synchro.*" minlevel="Debug" writeTo="synchro" />
	<logger name="NomadLogic.iBrandDesktop.Util.SubmitAction.Generic.Worker.*" minlevel="Trace" writeTo="main" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.ScanScreenAbstract" minlevel="Trace" writeTo="main" />
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.BarcodeEshotsScreen" minlevel="Trace" writeTo="main" />
	
	<logger name="NomadLogic.iBrandDesktop.Services.IbrandDatabase" minlevel="Debug" writeTo="main" />
	
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.Helpers.ImageListTransform" minlevel="Debug" writeTo="main" />
	<logger name="NomadLogic.Common.Xangle.XangleDetectionManager" minlevel="Debug" writeTo="main"/>
	<logger name="NomadLogic.iBrandDesktop.Ui.ApplicationScreen.Generic.RecordVideoScreen" minlevel="Trace" writeTo="main" />
	<logger name="NomadLogic.iBrandDesktop.Synchro.UploadData" minlevel="Debug" writeTo="synchro" />
	<logger name="NomadLogic.iBrandDesktop.Synchro.UploadDataLive" minlevel="Debug" writeTo="synchro" />
	<logger name="NomadLogic.Common.Util.QuestionnaireWebRequest.*" minlevel="Trace" writeTo="rest" />
	<logger name="NomadLogic.Common.Util.HttpRestUtil" minlevel="Trace" writeTo="rest" />

	<logger name="NomadLogic.iBrandDesktop.Services.*" minlevel="Info" writeTo="synchro" />
	-->
    <logger name="*" minlevel="Info" writeTo="main" />
  </rules>
</nlog>