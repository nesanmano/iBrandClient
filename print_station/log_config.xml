<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false">

  <targets>
    <target name="main" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="main.log"
      archiveFileName="archives/main.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
    enableArchiveFileCompression="true" />
  </targets>
  
  <targets>
    <target name="rest" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=false}] => ${message} ${exception:format=ToString}"
      fileName="rest.log"
      archiveFileName="archives/rest.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
    enableArchiveFileCompression="true" />
  </targets>
  
  <targets>
    <target name="synchro" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="synchro.log"
      archiveFileName="archives/synchro.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
    enableArchiveFileCompression="true" />
  </targets>

	<targets>
    <target name="cli" xsi:type="File" encoding="utf-8"
      layout="[${level}] ${longdate} [${processid}:${processname} - ${callsite:className=true:includeSourcePath=true}] => ${message} ${exception:format=ToString}"
      fileName="cli.log"
      archiveFileName="archives/cli.{#}.zip"
      archiveEvery="Day"
      archiveNumbering="Rolling"
      maxArchiveFiles="7"
    enableArchiveFileCompression="true" />
  </targets>

